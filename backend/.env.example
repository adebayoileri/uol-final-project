# Path to the whisper.cpp GGML model used by /transcribe and /pronunciation-check.
# Download with:
#   curl -L -o models/ggml-base.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
WHISPER_MODEL_PATH=backend/models/ggml-base.en.bin

# Piper voice names used by /tts. Download with:
#   python -m piper.download_voices <voice> --data-dir backend/voices
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_ES=es_ES-davefx-medium
